{
  "name": "@loams-plugins/root",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "test": "vp test",
    "test:watch": "vp test --watch",
    "test:coverage": "vp test --coverage",
    "lint": "vp lint",
    "format": "vp fmt",
    "mcp": "ENABLE_MCP=true tsx apps/server/src/index.ts",
    "dev:server": "tsx apps/server/src/index.ts",
    "dev:ui": "npm run dev --workspace=@loams-plugins/dashboard-ui",
    "dev": "tsx apps/server/src/index.ts"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.2.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@connectrpc/connect-web": "^2.2.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^9.0.0",
    "msw": "^2.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vite-plus": "1.0.0",
    "vitest": "5.0.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.0.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "download"
    }
  }
}
